// ============================== HELPERS =====================================
float finiteOr0(float x) { return isfinite(x) ? x : 0.0f; }
bool timeValid() { return time(nullptr) > 1700000000; }

const char* validateLimits(float oV, float uV, float oI, float tI, float mB, float lB, float tar, float rdl) {
  if (!(oV >= 200 && oV <= 260))    return "Over-voltage must be 200-260 V";
  if (!(uV >= 100 && uV <= 220))    return "Under-voltage must be 100-220 V";
  if (uV >= oV)                     return "Under-voltage must be below over-voltage";
  if (!(oI >= 1 && oI <= 100))      return "Overload must be 1-100 A";
  if (!(tI >= 0.005f && tI <= 1))   return "Theft current must be 0.005-1 A";
  if (!(mB >= 0 && mB <= 10000))    return "Cut-off balance must be 0-10000";
  if (!(lB >= 0 && lB <= 100000))   return "Low credit must be 0-100000";
  if (!(tar >= 1 && tar <= 5000))   return "Tariff must be 1-5000 per kWh";
  if (!(rdl >= 5 && rdl <= 900))    return "Restore delay must be 5-900 s";
  return NULL;
}

// ============================== STORAGE =====================================
