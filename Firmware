  prefs.putFloat("overV", overV);   prefs.putFloat("underV", underV);
  prefs.putFloat("overI", overI);   prefs.putFloat("theftI", theftI);
  prefs.putFloat("minBal", minBalance); prefs.putFloat("lowBal", lowBal);
  prefs.putFloat("tariff", tariff); prefs.putFloat("rdelay", restoreSec);
}

void loadSettings() {
  overV = prefs.getFloat("overV", DEF_OVER_V);   underV = prefs.getFloat("underV", DEF_UNDER_V);
  overI = prefs.getFloat("overI", DEF_OVER_I);   theftI = prefs.getFloat("theftI", DEF_THEFT_I);
  minBalance = prefs.getFloat("minBal", DEF_MIN_BAL); lowBal = prefs.getFloat("lowBal", DEF_LOW_BAL);
  tariff = prefs.getFloat("tariff", DEF_TARIFF); restoreSec = prefs.getFloat("rdelay", DEF_RESTORE_SEC);
  if (validateLimits(overV, underV, overI, theftI, minBalance, lowBal, tariff, restoreSec)) {
    overV = DEF_OVER_V; underV = DEF_UNDER_V; overI = DEF_OVER_I; theftI = DEF_THEFT_I;
    minBalance = DEF_MIN_BAL; lowBal = DEF_LOW_BAL; tariff = DEF_TARIFF; restoreSec = DEF_RESTORE_SEC;
    saveSettings();
  }
  balance = prefs.getDouble("bal", 0.0);
  if (!isfinite(balance) || balance < 0) balance = 0;
  lastEnergy = prefs.getFloat("lastE", -1.0f);
  if (!isfinite(lastEnergy)) lastEnergy = -1.0f;
  todayKwh = prefs.getFloat("today", 0.0f);
  if (!isfinite(todayKwh) || todayKwh < 0) todayKwh = 0;
  lastYday = prefs.getInt("yday", -1);
  manualOff = prefs.getBool("mOff", false);
  adminPw = prefs.getString("pw", DEFAULT_PASSWORD);
  memset(txLog, 0, sizeof(txLog));
  if (prefs.getBytesLength("txlog") == sizeof(txLog)) prefs.getBytes("txlog", txLog, sizeof(txLog));
  savedBalance = balance;
}

// Balance and lastEnergy are always saved together, so after a power cut the
// meter simply re-bills the energy since the last save: nothing is lost or doubled.
void maybeSave(bool force) {
  unsigned long now = millis();
  bool need = force || fabs(balance - savedBalance) >= 0.5 ||
              (balance <= 0 && savedBalance > 0) || (dirty && now - lastSave > 600000UL);
  if (!need) return;
  prefs.putDouble("bal", balance);
  prefs.putFloat("lastE", lastEnergy);
  prefs.putFloat("today", todayKwh);
  prefs.putInt("yday", lastYday);
  savedBalance = balance; lastSave = now; dirty = false;
}

void addTx(float amount) {
  memmove(&txLog[1], &txLog[0], sizeof(Tx) * (TX_MAX - 1));
  txLog[0].t = timeValid() ? (uint32_t)time(nullptr) : 0;
  txLog[0].a = amount;
  prefs.putBytes("txlog", txLog, sizeof(txLog));
}

// ============================== RELAY =======================================
void driveRelay(bool on) {
  digitalWrite(RELAY_PIN, (on != RELAY_ACTIVE_LOW) ? HIGH : LOW);
}

void setRelay(bool on, const char* msg) {
  relayState = on;
  driveRelay(on);
  lastSwitch = millis();
  notify(msg, on ? C_GREEN : C_RED);
  Serial.printf("[Relay] %s (%s)\n", on ? "ON" : "OFF", msg);
}

bool supplyReady() {
  return supplyStableSince != 0 && (millis() - supplyStableSince) >= (unsigned long)(restoreSec * 1000.0f);
}

const char* offReason() {
  if (manualOff)                 return "Manually switched off";
  if (sensorFailed)              return "Meter sensor error";
  if (balance <= minBalance)     return "Insufficient credit";
  if (currentFault)              return "Overload fault active";
  if (!gridPresent)              return "No grid supply";
  if (!supplyReady())            return "Waiting for supply to stabilise";
  return NULL;
}

void evaluateRelay() {
  unsigned long now = millis();
  bool want;
  if (manualOff) want = false;
  else if (sensorFailed) want = relayState && !(now - sensorFailSince >= SENSOR_CUTOFF_MS);
  else want = (balance > minBalance) && !currentFault && supplyReady();

  if (want == relayState) return;
  if (!want) {
    const char* why = offReason();
    if (!why) why = "Meter fault cut-off";
    if (!sensorFailed && !gridPresent && !manualOff) why = "No grid supply";
    setRelay(false, why);
  } else if (now - lastSwitch >= MIN_SWITCH_MS) {
    setRelay(true, "Power ON");
  }
}

void clearFaultLatch() { faultLatched = false; currentFault = false; ocCnt = 0; tripCount = 0; }

// Shared by the web UI and the push button.
void userPower(bool on) {
  if (on) { manualOff = false; clearFaultLatch(); }
  else    { manualOff = true; }
  prefs.putBool("mOff", manualOff);
  evaluateRelay();
}

// ============================== METERING ====================================
void readPzem() {
  float v = pzem.voltage();
  if (isnan(v)) {
    if (sensorFails < 255) sensorFails++;
    if (sensorFails == 3) {
      sensorFailed = true; sensorFailSince = millis();
      readings.v = readings.i = readings.p = readings.f = readings.pf = 0;
      notify("PZEM not responding", C_RED, 8000);
    }
    return;
  }
  if (sensorFailed) notify("PZEM reconnected", C_GREEN);
  sensorFailed = false; sensorFails = 0; firstRead = true;
  readings.v = v;
  readings.i = finiteOr0(pzem.current());
  readings.p = finiteOr0(pzem.power());
  readings.f = finiteOr0(pzem.frequency());
  readings.pf = finiteOr0(pzem.pf());
  float e = pzem.energy();
  readings.eValid = isfinite(e);
  if (readings.eValid) readings.e = e;
}

void updateDay() {
  if (!timeValid()) return;
  time_t n = time(nullptr); struct tm t; localtime_r(&n, &t);
  if (t.tm_yday != lastYday) { todayKwh = 0; lastYday = t.tm_yday; dirty = true; }
}

void billing() {
  if (sensorFailed || !readings.eValid) return;
  if (lastEnergy < 0) { lastEnergy = readings.e; dirty = true; return; }  // first ever reading: don't bill history
  float d = readings.e - lastEnergy;
  if (d < 0 || d > 5.0f) { lastEnergy = readings.e; dirty = true; return; } // PZEM counter reset or glitch
  if (d <= 0) return;
  balance -= (double)d * tariff;
  if (balance < 0) balance = 0;
  lastEnergy = readings.e;
  if (timeValid()) todayKwh += d;
  dirty = true;
}

void updateProtection() {
  unsigned long now = millis();
  gridPresent = !sensorFailed && readings.v >= MIN_GRID_V;
  bool vOk = gridPresent && readings.v >= underV && readings.v <= overV;

  if (!sensorFailed) {
    badCnt = vOk ? 0 : (badCnt < 10 ? badCnt + 1 : 10);
    if (badCnt >= 2) supplyStableSince = 0;
    else if (vOk && supplyStableSince == 0) supplyStableSince = now;
  }
  bool newVF = gridPresent && !vOk && badCnt >= 2;
  if (newVF != voltFault) {
    voltFault = newVF;
    if (voltFault) { voltReason = readings.v > overV ? "Over-voltage" : "Low voltage"; notify(voltReason, C_RED); }
    else notify("Voltage normal", C_GREEN);
  }

  // Overload: 2 consecutive hits trips, 30 s cool-down, latches after 3 trips in 10 min
  bool oc = !sensorFailed && readings.i > overI;
  ocCnt = oc ? (ocCnt < 10 ? ocCnt + 1 : 10) : 0;
  if (!currentFault && ocCnt >= 2) {
    currentFault = true; faultTime = now;
    if (now - lastTripTime > 600000UL) tripCount = 0;
    tripCount++; lastTripTime = now;
    if (tripCount >= 3) { faultLatched = true; notify("OVERLOAD LATCHED!", C_RED, 10000); }
    else notify("OVERLOAD! Power cut", C_RED);
  } else if (currentFault && !faultLatched && !oc && now - faultTime >= FAULT_COOLDOWN) {
    currentFault = false; notify("Overload cleared", C_GREEN);
  }

  // Theft: current flowing while relay is open (needs CT on supply side)
  bool tRaw = !relayState && !sensorFailed && (now - lastSwitch > 3000) && readings.i > theftI;
  if (tRaw) { if (tCnt < 10) tCnt++; tClr = 0; } else { if (tClr < 10) tClr++; tCnt = 0; }
  if (!theftDetected && tCnt >= 3) { theftDetected = true; notify("THEFT DETECTED!", C_RED, 10000); }
  else if (theftDetected && tClr >= 3) { theftDetected = false; notify("Theft alert cleared", C_GREEN); }

  // Low credit warning (once per drop)
  if (balance > lowBal) lowNotified = false;
  else if (!lowNotified && relayState && balance > minBalance) { notify("Low credit! Recharge", C_YELLOW, 8000); lowNotified = true; }
}

int statusId() {
  if (sensorFailed)             return S_SENSOR;
  if (!firstRead)               return S_START;
  if (!gridPresent)             return S_NOGRID;
  if (currentFault || voltFault) return S_FAULT;
  if (theftDetected)            return S_THEFT;
  if (manualOff)                return S_MANUAL;
  if (balance <= minBalance)    return S_NOCREDIT;
  if (!relayState)              return S_RESTORE;
  if (balance <= lowBal)        return S_LOW;
  return S_ACTIVE;
}

const char* faultText() {
  if (currentFault) return faultLatched ? "Overload latched. Press Power ON to reset" : "Overload cut-off";
  if (voltFault) return voltReason;
  return "";
}

