// ============================== BUTTON ======================================
void handleButton() {
  static bool lastRaw = HIGH, stable = HIGH, longDone = false;
  static unsigned long lastChange = 0, pressStart = 0;
  bool raw = digitalRead(BUTTON_PIN);
  unsigned long now = millis();
  if (raw != lastRaw) { lastChange = now; lastRaw = raw; }
  if (now - lastChange > DEBOUNCE_MS && raw != stable) {
    stable = raw;
    if (stable == LOW) { pressStart = now; longDone = false; }
    else if (!longDone) { displayPage ^= 1; layoutDrawn = false; }       // short press: change page
  }
  if (stable == LOW && !longDone && now - pressStart >= LONG_PRESS_MS) {  // long press: toggle power
    longDone = true;
    userPower(!relayState);
    if (!relayState && !manualOff) { const char* why = offReason(); if (why) notify(why, C_YELLOW); }
  }
}

// ============================== WI-FI =======================================
void startAP() {
  if (apActive) return;
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  apActive = true;
  Serial.printf("[WiFi] Fallback AP '%s' at %s\n", AP_SSID, WiFi.softAPIP().toString().c_str());
}

void stopAP() {
  if (!apActive) return;
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  apActive = false;
}

void refreshIp() {
  String n; bool ap = false;
  if (WiFi.status() == WL_CONNECTED) n = WiFi.localIP().toString();
  else if (apActive) { n = WiFi.softAPIP().toString(); ap = true; }
  if (n != ipStr || ap != ipIsAp) {
    ipStr = n; ipIsAp = ap;
    if (uiReady && !notifActive) drawFooter();
  }
}

void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);
  WiFi.setHostname(HOSTNAME);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  tft.fillRect(0, 76, 160, 40, C_BLACK);
  tft.setTextSize(1); tft.setTextColor(C_WHITE, C_BLACK);
  tft.setCursor(8, 78); tft.print("Connecting WiFi...");
  unsigned long start = millis(); int x = 8;
  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_BOOT_TIMEOUT) {
    delay(500);
    tft.setCursor(x, 92); tft.print("."); x += 6; if (x > 150) x = 8;
  }
  tft.fillRect(0, 76, 160, 40, C_BLACK);
  tft.setCursor(8, 78);
  if (WiFi.status() == WL_CONNECTED) {
    lastConnectedMs = millis();
    tft.setTextColor(C_GREEN, C_BLACK); tft.print("WiFi connected");
    tft.setCursor(8, 92); tft.setTextColor(C_WHITE, C_BLACK); tft.print(WiFi.localIP().toString());
    Serial.printf("[WiFi] Connected, IP %s\n", WiFi.localIP().toString().c_str());
  } else {
    tft.setTextColor(C_RED, C_BLACK); tft.print("WiFi failed");
    tft.setCursor(8, 92); tft.setTextColor(C_YELLOW, C_BLACK); tft.print("Starting setup AP");
    startAP();
  }
  delay(1200);
}

void maintainWiFi() {
  static unsigned long last = 0, connectedSince = 0, lastRetry = 0;
  unsigned long now = millis();
  if (now - last < 2000) return;
  last = now;
  if (WiFi.status() == WL_CONNECTED) {
    lastConnectedMs = now;
    if (!connectedSince) { connectedSince = now; notify("WiFi connected", C_GREEN); }
    if (!mdnsStarted && MDNS.begin(HOSTNAME)) { MDNS.addService("http", "tcp", 80); mdnsStarted = true; }
    if (apActive && now - connectedSince > 30000) stopAP();
  } else {
    if (connectedSince) { connectedSince = 0; notify("WiFi lost", C_YELLOW); }
    if (!apActive && now - lastConnectedMs > 20000) startAP();
    if (now - lastRetry > 15000) { lastRetry = now; WiFi.reconnect(); }
  }
  refreshIp();
}

// ============================== AUTH ========================================
void newSession() {
  char buf[33];
  snprintf(buf, sizeof(buf), "%08X%08X%08X%08X", esp_random(), esp_random(), esp_random(), esp_random());
  sessionToken = buf; lastActivity = millis();
}

bool isAuthed() {
  if (sessionToken.length() != 32) return false;
  if (millis() - lastActivity > SESSION_MS) { sessionToken = ""; return false; }
  String c = server.header("Cookie");
  int p = c.indexOf("ESPSESSID=");
  if (p < 0) return false;
  if (c.substring(p + 10, p + 42) == sessionToken) { lastActivity = millis(); return true; }
  return false;
}

void redirectTo(const char* url) {
  server.sendHeader("Location", url);
  server.sendHeader("Cache-Control", "no-store");
  server.send(303, "text/plain", "");
}

void sendJson(int code, const char* body) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(code, "application/json", body);
}

void sendMsg(bool ok, const char* msg) {
  char b[200];
  snprintf(b, sizeof(b), "{\"success\":%s,\"message\":\"%s\"}", ok ? "true" : "false", msg);
  sendJson(200, b);
}

bool requireApi() {
  if (isAuthed()) return true;
  sendJson(401, "{\"success\":false,\"message\":\"Session expired\"}");
  return false;
}

bool argF(const char* name, float& out) {
  if (!server.hasArg(name)) return false;
  String s = server.arg(name); s.trim();
  if (!s.length()) return false;
  char* end; out = strtof(s.c_str(), &end);
  return end != s.c_str() && isfinite(out);
}

// ============================== WEB HANDLERS ================================
void handleRoot() {
  if (!isAuthed()) { redirectTo("/login"); return; }
  server.sendHeader("Cache-Control", "no-store");
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleLoginGet() {
  server.sendHeader("Cache-Control", "no-store");
  server.send_P(200, "text/html", LOGIN_HTML);
}

void handleLoginPost() {
  unsigned long now = millis();
  if (now < lockUntil) { redirectTo("/login?locked=1"); return; }
  if (server.arg("username") == ADMIN_USER && server.arg("password") == adminPw) {
    failCount = 0;
    newSession();
    server.sendHeader("Set-Cookie", "ESPSESSID=" + sessionToken + "; Path=/; HttpOnly; SameSite=Strict");
    redirectTo("/");
  } else {
    if (++failCount >= 5) { lockUntil = now + 60000UL; failCount = 0; }
    delay(500);
    redirectTo("/login?error=1");
  }
}

void handleLogout() {
  sessionToken = "";
  server.sendHeader("Set-Cookie", "ESPSESSID=; Path=/; Max-Age=0");
  redirectTo("/login");
}

void handleData() {
  if (!requireApi()) return;
  unsigned long now = millis();
  float units = tariff > 0 ? (float)(balance / tariff) : 0;
  float hrs = -1;
  if (readings.p > 20 && tariff > 0) hrs = (float)(balance / ((readings.p / 1000.0f) * tariff));
  int restore = 0;
  if (supplyStableSince != 0 && !supplyReady())
    restore = (int)(((unsigned long)(restoreSec * 1000.0f) - (now - supplyStableSince)) / 1000UL) + 1;
  int sid = statusId();
  char b[1024];
  snprintf(b, sizeof(b),
    "{\"v\":%.1f,\"i\":%.3f,\"p\":%.1f,\"e\":%.3f,\"f\":%.1f,\"pf\":%.2f,"
    "\"bal\":%.2f,\"units\":%.2f,\"st\":\"%s\",\"fault\":\"%s\",\"relay\":%s,\"manual\":%s,\"theft\":%s,"
    "\"today\":%.3f,\"todayN\":%.2f,\"todayOk\":%s,\"hrs\":%.1f,\"restore\":%d,"
    "\"tariff\":%.2f,\"minBal\":%.2f,\"lowBal\":%.2f,\"overV\":%.0f,\"underV\":%.0f,\"overI\":%.1f,\"theftI\":%.3f,\"rdelay\":%.0f,"
    "\"rssi\":%d,\"ip\":\"%s\",\"ap\":%s,\"defpw\":%s,\"up\":%lu}",
    readings.v, readings.i, readings.p, readings.e, readings.f, readings.pf,
    balance, units, STATUS_NAME[sid], faultText(), relayState ? "true" : "false", manualOff ? "true" : "false",
    theftDetected ? "true" : "false",
    todayKwh, todayKwh * tariff, timeValid() ? "true" : "false", hrs, restore,
    tariff, minBalance, lowBal, overV, underV, overI, theftI, restoreSec,
    WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0, ipStr.c_str(), apActive ? "true" : "false",
    (adminPw == DEFAULT_PASSWORD) ? "true" : "false", now / 1000UL);
  sendJson(200, b);
}

void handleHistory() {
  if (!requireApi()) return;
  String s = "[";
  bool first = true;
  for (int i = 0; i < TX_MAX; i++) {
    if (txLog[i].a <= 0) continue;
    if (!first) s += ",";
    first = false;
    char e[48]; snprintf(e, sizeof(e), "{\"t\":%lu,\"a\":%.2f}", (unsigned long)txLog[i].t, txLog[i].a);
    s += e;
  }
  s += "]";
  sendJson(200, s.c_str());
}

void handleRecharge() {
  if (!requireApi()) return;
  float a;
  if (!argF("amount", a) || a < MIN_RECHARGE || a > MAX_RECHARGE) { sendMsg(false, "Enter an amount between 100 and 500000"); return; }
  a = roundf(a * 100.0f) / 100.0f;
  balance += a;
  addTx(a);
  maybeSave(true);
  lowNotified = false;
  evaluateRelay();
  char n[28]; snprintf(n, sizeof(n), "Recharged NGN %.0f", a);
  notify(n, C_GREEN);
  char b[160];
  snprintf(b, sizeof(b), "{\"success\":true,\"message\":\"Recharge successful\",\"balance\":%.2f}", balance);
  sendJson(200, b);
}

void handleSetRelay() {
  if (!requireApi()) return;
  if (!server.hasArg("state")) { sendMsg(false, "Missing state"); return; }
  int st = server.arg("state").toInt();
  if (st == 0) { userPower(false); sendMsg(true, "Power switched OFF"); return; }
  userPower(true);
  if (relayState) { sendMsg(true, "Power is ON"); return; }
  const char* why = offReason();
  if (!why || strstr(why, "stabilise")) sendMsg(true, "Command accepted. Power returns shortly");
  else sendMsg(false, why);
}

void handleSettings() {
  if (!requireApi()) return;
  float oV, uV, oI, tI, mB, lB, tar, rdl;
  if (!argF("overV", oV) || !argF("underV", uV) || !argF("overI", oI) || !argF("theftI", tI) ||
      !argF("minBal", mB) || !argF("lowBal", lB) || !argF("tariff", tar) || !argF("rdelay", rdl)) {
    sendMsg(false, "Fill in every field with a valid number"); return;
  }
  const char* err = validateLimits(oV, uV, oI, tI, mB, lB, tar, rdl);
  if (err) { sendMsg(false, err); return; }
  overV = oV; underV = uV; overI = oI; theftI = tI; minBalance = mB; lowBal = lB; tariff = tar; restoreSec = rdl;
  saveSettings();
  invalidateCaches();
  notify("Settings updated", C_GREEN);
  sendMsg(true, "Settings saved");
}

void handlePassword() {
  if (!requireApi()) return;
  String o = server.arg("oldPw"), n = server.arg("newPw");
  if (o != adminPw) { sendMsg(false, "Current password is wrong"); return; }
  if (n.length() < 6 || n.length() > 32) { sendMsg(false, "New password must be 6-32 characters"); return; }
  if (n == DEFAULT_PASSWORD) { sendMsg(false, "Choose a different password"); return; }
  adminPw = n;
  prefs.putString("pw", adminPw);
  sendMsg(true, "Password changed");
}

void handleFactoryReset() {
  if (!requireApi()) return;
  if (server.arg("pw") != adminPw) { sendMsg(false, "Wrong password"); return; }
  sendMsg(true, "Resetting. Meter is restarting");
  notify("Factory reset...", C_YELLOW, 3000);
  delay(500);
  prefs.clear();
  delay(200);
  ESP.restart();
}

void handleNotFound() { server.send(404, "text/plain", "404: Not found"); }

// ============================== SETUP / LOOP ================================
void setup() {
  Serial.begin(115200);
  delay(300);

  // Relay first, and OFF: the meter only closes it after credit and supply are verified.
  pinMode(RELAY_PIN, OUTPUT);
  driveRelay(false);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  prefs.begin("meter", false);
  loadSettings();

  tft.initR(INITR_BLACKTAB);
  tft.setRotation(1);
  tft.setTextWrap(false);
  splash();

  sensorFailSince = millis();
  connectWiFi();
  configTime(3600, 0, "pool.ntp.org", "time.google.com");   // WAT = UTC+1, no DST
  refreshIp();

  const char* hdrs[] = {"Cookie"};
  server.collectHeaders(hdrs, 1);
  server.on("/", HTTP_GET, handleRoot);
  server.on("/login", HTTP_GET, handleLoginGet);
  server.on("/login", HTTP_POST, handleLoginPost);
  server.on("/logout", HTTP_GET, handleLogout);
  server.on("/data", HTTP_GET, handleData);
  server.on("/history", HTTP_GET, handleHistory);
  server.on("/recharge", HTTP_POST, handleRecharge);
  server.on("/setRelay", HTTP_POST, handleSetRelay);
  server.on("/settings", HTTP_POST, handleSettings);
  server.on("/password", HTTP_POST, handlePassword);
  server.on("/factoryReset", HTTP_POST, handleFactoryReset);
  server.onNotFound(handleNotFound);
  server.begin();

  drawLayout();
  notify("System ready", C_GREEN, 3000);
}

void loop() {
  static unsigned long lastRead = 0, lastDraw = 0, lastReminder = 0;
  server.handleClient();
  unsigned long now = millis();

  if (now - lastRead >= READ_INTERVAL) {
    lastRead = now;
    readPzem();
    billing();
    updateDay();
    updateProtection();
    evaluateRelay();
    maybeSave(false);
  }

  handleButton();
  maintainWiFi();

  if (notifActive && now >= notifEnd) { notifActive = false; if (uiReady) drawFooter(); }

  if (now - lastReminder >= REMINDER_INTERVAL) {
    lastReminder = now;
    int s = statusId();
    if (s == S_SENSOR)        notify("PZEM disconnected!", C_RED);
    else if (s == S_FAULT)    notify("Fault active! Check", C_RED);
    else if (s == S_THEFT)    notify("Theft alert active!", C_RED);
    else if (s == S_NOCREDIT) notify("No credit. Recharge", C_YELLOW);
    else if (s == S_LOW)      notify("Low credit! Recharge", C_YELLOW);
  }

  if (now - lastDraw >= DISPLAY_INTERVAL) { lastDraw = now; updateDisplay(); }
}
